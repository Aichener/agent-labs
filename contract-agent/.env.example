# 任何 OpenAI 兼容端点都可以：Ollama / vLLM / DeepSeek / 各厂商兼容模式
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=not-needed
# 可选：每 1K token 价格（美元），用于成本核算
LLM_PRICE_PER_1K=0

# HTTP 服务（python -m agent.api）
# key:租户，逗号分隔；不设则用仅本机可用的 dev-key
AGENT_API_KEYS=dev-key:demo
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_TIMEOUT=30
# 结果库（SQLite）；留空则用 data/tasks.db
AGENT_DB=
